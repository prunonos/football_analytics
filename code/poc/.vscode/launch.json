    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "-l 1 2 5 10 -d 1 1 2 4 -v 3 --datalake_version 3"
